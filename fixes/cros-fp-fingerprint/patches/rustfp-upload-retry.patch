diff --git a/rust-fp/src/drivers/cros_fp.rs b/rust-fp/src/drivers/cros_fp.rs
index 2005989..7dac657 100644
--- a/rust-fp/src/drivers/cros_fp.rs
+++ b/rust-fp/src/drivers/cros_fp.rs
@@ -235,20 +235,83 @@ impl OpenedFingerprintDriver for OpenedCrosFp {
                 if hashes.iter().collect::<HashSet<_>>()
                     != self.loaded_templates_hashes.iter().collect()
                 {
+                    // The FPMCU answers set_context and template uploads with
+                    // Busy/Unavailable while it is still finishing a previous
+                    // operation. That is the normal state when one verify
+                    // follows another, which is exactly how fprintd drives it.
+                    //
+                    // Previously this slept a flat 10ms and unwrapped, so a busy
+                    // sensor produced either a panic (set_context) or a hard
+                    // error (upload) instead of a retry. Back off and try again.
+                    // Setting the context re-derives the template encryption key on
+                    // the FPMCU. That is asynchronous: the command returns, but for
+                    // some time afterwards other commands answer Unavailable, and a
+                    // second set_context answers Busy because the first is still in
+                    // flight. Measured on nocturne_fp: uploading 150ms after
+                    // set_context always returned Unavailable.
+                    //
+                    // So: reset once, establish the context, wait for it to settle,
+                    // then upload - retrying the upload rather than the context.
                     fp_mode(&mut self.file, FpMode::Reset as u32)
                         .map_err(|_e| format!("Error doing {:?}", FpMode::Reset))?;
-                    self.set_context();
-                    // Without waiting a bit, the template uploading can fail.
-                    // Maybe 10ms is enough, idk what is the smallest amount that works 99% of the time.
-                    sleep(Duration::from_millis(10)).await;
-                    for template in templates {
-                        fp_upload_template(
-                            &mut self.file,
-                            &self.protocol_info,
-                            &self.fp_info,
-                            &unsafe { FpTemplate::from_vec_unchecked(template.to_vec()) },
-                        )
-                        .map_err(|e| format!("Error uploading template: {e:?}"))?;
+                    sleep(Duration::from_millis(50)).await;
+
+                    // Establish the context, waiting out a Busy from any previous
+                    // context change rather than piling another on top of it.
+                    let mut ctx_attempt: u32 = 0;
+                    loop {
+                        ctx_attempt += 1;
+                        match fp_set_context(&mut self.file, [0xaa; 32]) {
+                            Ok(_) => {
+                                self.loaded_templates_hashes.clear();
+                                break;
+                            }
+                            Err(e) if ctx_attempt < 6 => {
+                                println!(
+                                    "  set_context busy ({e:?}); waiting for the previous \
+                                     context change to finish (attempt {ctx_attempt})"
+                                );
+                                sleep(Duration::from_millis(500 * ctx_attempt as u64)).await;
+                            }
+                            Err(e) => return Err(format!("Error setting context: {e:?}").into()),
+                        }
+                    }
+
+                    println!(
+                        "  context set; MCU template_size={}, max={}, valid={}",
+                        self.fp_info.template_size,
+                        self.fp_info.template_max,
+                        self.fp_info.template_valid
+                    );
+
+                    // Let the key derivation finish before uploading anything.
+                    let mut up_attempt: u32 = 0;
+                    loop {
+                        up_attempt += 1;
+                        sleep(Duration::from_millis(750 * up_attempt as u64)).await;
+
+                        let mut result: Result<(), String> = Ok(());
+                        for template in templates {
+                            if let Err(e) = fp_upload_template(
+                                &mut self.file,
+                                &self.protocol_info,
+                                &self.fp_info,
+                                &unsafe { FpTemplate::from_vec_unchecked(template.to_vec()) },
+                            ) {
+                                result = Err(format!("Error uploading template: {e:?}"));
+                                break;
+                            }
+                        }
+                        match result {
+                            Ok(()) => {
+                                println!("  uploaded {} template(s)", templates.len());
+                                break;
+                            }
+                            Err(e) if up_attempt < 5 => {
+                                println!("  upload attempt {up_attempt} failed: {e}. Retrying.");
+                            }
+                            Err(e) => return Err(e.into()),
+                        }
                     }
                     self.loaded_templates_hashes.clone_from(&hashes);
                 }
