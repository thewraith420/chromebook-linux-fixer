#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""chromebook-fixer-gui — Nightfall Boot Manager, and a window over the CLI.

Deliberately a front-end, not a reimplementation: it shells out to the same
CLI, so detection, safety gating and the fix lifecycle have exactly one
implementation. Anything the GUI can do, the CLI can do, and they cannot drift.
"""

import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, Gio, GLib, Gtk, Pango  # noqa: E402

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
from registry import CATEGORIES, Machine, load_fixes  # noqa: E402

RISK_STYLE = {"low": "success", "medium": "warning", "high": "error"}
STATE_TEXT = {
    "applied": ("Applied", "success"),
    "needed": ("Needed", "warning"),
    "ok": ("Not needed", "dim-label"),
    "unknown": ("Unknown", "dim-label"),
}


def askpass_env():
    """
    Fix scripts escalate as root, and there is no terminal here to type a
    password into. Rather than decide how, tell the CLI it has no tty and let
    registry.sudo_command() choose: pkexec, so the desktop's polkit agent
    authenticates however the machine is set up to - a fingerprint reader,
    typically - falling back to `sudo -A` and a graphical askpass helper.
    (Setting SUDO_ASKPASS alone would not be enough: sudo reads it only when
    invoked as `sudo -A`.)

    Announcing it rather than letting the CLI probe for /dev/tty matters when
    the GUI is launched *from* a terminal: that tty exists but the user is
    looking at this window, so a prompt there would look like a hang.
    """
    env = dict(os.environ)
    env["FIXER_NO_TTY"] = "1"
    return env


class FixRow(Adw.ExpanderRow):
    def __init__(self, fix, window):
        super().__init__(title=fix.name, subtitle=fix.id)
        self.fix = fix
        self.window = window

        self.state_label = Gtk.Label(label="checking…")
        self.state_label.add_css_class("dim-label")
        self.add_suffix(self.state_label)

        risk = Gtk.Label(label=fix.risk)
        risk.add_css_class(RISK_STYLE.get(fix.risk, "dim-label"))
        risk.add_css_class("caption")
        self.add_suffix(risk)

        if fix.description:
            self.add_row(self._text_row(fix.description))
        if fix.danger:
            warn = self._text_row(fix.danger)
            warn.add_css_class("error")
            self.add_row(warn)
        if not fix.reverts_cleanly:
            self.add_row(self._text_row("This fix cannot be cleanly reverted."))

        actions = Adw.ActionRow()
        box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        self.apply_btn = Gtk.Button(label="Apply")
        self.apply_btn.add_css_class("suggested-action")
        self.apply_btn.connect("clicked", lambda _b: window.run_action("apply", fix))
        self.revert_btn = Gtk.Button(label="Revert")
        self.revert_btn.connect("clicked", lambda _b: window.run_action("revert", fix))
        box.append(self.apply_btn)
        box.append(self.revert_btn)
        # Only for fixes that keep one. Nightfall is the only one today, but
        # this asks the fix rather than naming it, so another that grows a
        # logs.sh gets the button without touching the GUI.
        if fix.has("logs"):
            logs_btn = Gtk.Button(label="Logs")
            logs_btn.set_tooltip_text("Show this fix's own diagnostic log")
            logs_btn.connect("clicked", lambda _b: window.view_logs(fix))
            box.append(logs_btn)
        actions.add_suffix(box)
        self.add_row(actions)

    @staticmethod
    def _text_row(text):
        row = Adw.ActionRow()
        label = Gtk.Label(label=text.strip(), wrap=True, xalign=0,
                          margin_top=6, margin_bottom=6)
        label.add_css_class("caption")
        row.set_child(label)
        return row

    def refresh(self):
        """Paint whatever the window's sweep has found for this fix so far."""
        found = self.window.status_of(self.fix)
        if found is None:
            self.state_label.set_label("checking…")
            self.apply_btn.set_sensitive(False)
            self.revert_btn.set_sensitive(False)
            return
        self.show_status(*found)

    def show_status(self, state, detail):
        text, style = STATE_TEXT[state]
        self.state_label.set_label(text)
        for s in ("success", "warning", "dim-label"):
            self.state_label.remove_css_class(s)
        self.state_label.add_css_class(style)
        if detail:
            self.set_subtitle(f"{self.fix.id} — {detail.splitlines()[0]}")
        self.apply_btn.set_sensitive(state in ("needed", "unknown")
                                     and self.fix.has("apply"))
        self.revert_btn.set_sensitive(state == "applied" and self.fix.has("revert"))


class Window(Adw.ApplicationWindow):
    """
    Three levels: Nightfall, then the fix categories, then one category.

    Home is Nightfall Boot Manager - installed or not, what it did on the last
    boot, and every setting that changes it - because that is what this machine
    runs on every boot. The hardware fixes sit one level down behind a single
    row: twenty expander rows of hardware jargon read as intimidating rather
    than useful, and they are where you go when something is broken, not
    something you look at daily. Every row that stands for others carries a
    count of what needs attention, so nothing hides behind a heading.
    """

    def __init__(self, app):
        super().__init__(application=app, title="Nightfall — Chromebook Fixer",
                         default_width=760, default_height=self._screen_cap_height())
        self.machine = Machine.detect()
        self.rows = []              # every FixRow, for refreshing
        self.category_rows = {}     # category key -> (row, fixes)
        # fix id -> (state, detail), filled by the background sweep. Every page
        # reads this; nothing on the GUI thread ever runs a detect script.
        self._status = {}
        self._sweeping = False
        self._resweep = False
        self._fitted = False        # has the post-detection re-fit happened?

        self.nav = Adw.NavigationView()
        self.nav.add(self._build_root())
        self.toasts = Adw.ToastOverlay(child=self.nav)
        self.set_content(self.toasts)
        # Now that the page exists, open as tall as it actually is - or as tall
        # as the last run worked out, which is the same number without the
        # visible jump when detection lands. See _refit.
        self._set_height = self._remembered_height() or self._fit_to_content()
        self.set_default_size(760, self._set_height)

        GLib.idle_add(self.refresh_all)

    @staticmethod
    def _screen_cap_height(fallback=900):
        """
        The tallest this window should ever open: 92% of the monitor, so it
        never runs off a screen that has turned. A ceiling, not a size - see
        _fit_to_content for why.
        """
        try:
            monitors = Gdk.Display.get_default().get_monitors()
            geometry = monitors.get_item(0).get_geometry()
            return max(600, min(1300, int(geometry.height * 0.92)))
        except Exception:                                  # noqa: BLE001
            return fallback

    def _fit_to_content(self):
        """
        Open as tall as the tallest page needs, up to the screen's cap.

        A constant went stale twice as rows were added (720, then 900 - each
        cut off the last category), and 92% of the screen opened 1300px tall in
        portrait for about 1000px of content. Both sized the window from
        something other than what is in it, so this measures instead.

        Every page, not only the root: the window's height is fixed once it
        opens, and the pages below are drawn in it. Home carries Nightfall and
        its settings and is usually the tallest, but a category page can beat
        it. Pages are built here and never shown; FixRows run no detection
        until refreshed, so this costs widgets, not checks.

        A page's height is the larger of its own natural height and the sum of
        its groups plus Adwaita's spacing. The page scrolls internally, so it
        can report the scroller's height rather than its content's; groups do
        not scroll, so their sum is the reliable half. Groups are measured
        narrower than the window because the page clamps them, and measuring
        wide would under-count the lines their descriptions wrap onto.
        """
        cap = self._screen_cap_height()
        try:
            def natural(widget, width):
                return widget.measure(Gtk.Orientation.VERTICAL, width)[1]

            def page_height(page, groups):
                return max(natural(page, 760),
                           sum(natural(g, 560) for g in groups)
                           + 24 * len(groups) + 48)

            tallest = page_height(self._root_page, self._root_groups)
            page, groups, _rows = self._build_fixes_page()
            tallest = max(tallest, page_height(page, groups))
            for key in self.fixes_by_category:
                page, groups, _rows = self._build_category_page(key, "")
                tallest = max(tallest, page_height(page, groups))
            want = natural(self._root_header, 760) + tallest
            if want > 200:                     # a failed measure reads as ~0
                return max(600, min(cap, want))
        except Exception:                                  # noqa: BLE001
            pass
        return cap

    # -- level 1: Nightfall -------------------------------------------------

    # Nightfall's own fixes: installing it, and making it GRUB's default.
    # They live on the home page, so they are left out of the category list
    # rather than appearing in both places.
    NIGHTFALL_FIXES = ("nightfall", "nightfall-default")

    def _build_root(self):
        """
        Home is Nightfall: what it is doing, and everything that changes it.

        The hardware fixes are what this tool started as, but they are where
        you go when something is broken, while Nightfall is used on every
        boot. So they moved one level down, behind a single row that still
        carries the count of anything needing attention - nothing can hide
        behind it, because refresh_all counts every fix it stands for.
        """
        page = Adw.PreferencesPage()

        applicable = [f for f in load_fixes() if f.matches(self.machine)]
        by_id = {f.id: f for f in applicable}
        # Data, not widgets. Pages are built more than once - measuring builds
        # them too - so what a category holds cannot live inside a page.
        self.fixes_by_category = {}
        for key in CATEGORIES:
            fixes = [f for f in applicable
                     if f.category == key and f.id not in self.NIGHTFALL_FIXES]
            if fixes:
                self.fixes_by_category[key] = fixes

        nf = Adw.PreferencesGroup(
            title="Nightfall Boot Manager",
            description="The touch boot manager this machine starts in. "
                        "Nothing is changed until you press Apply.")
        for fid in self.NIGHTFALL_FIXES:
            fix = by_id.get(fid)
            if fix is None:
                continue
            row = FixRow(fix, self)
            self.rows.append(row)          # built once, so refreshed with the rest
            nf.add(row)
        page.add(nf)

        # One list for the sweep to walk: Nightfall's fixes and every other
        # applicable one, in the order they are shown.
        self._all_fixes = [r.fix for r in self.rows]
        self._all_fixes += [f for fixes in self.fixes_by_category.values()
                            for f in fixes]

        settings, handles = self._build_boot_settings()
        # Home is built once and never rebuilt, so these handles are the ones
        # _refresh_boot_menu should always write to.
        self.boot = handles
        nf_settings, grub_settings = settings[0], settings[1:]
        page.add(nf_settings)
        kernels = self._build_kernels()
        page.add(kernels)
        backups = self._build_backups()
        page.add(backups)
        for group in grub_settings:
            page.add(group)

        info = Adw.PreferencesGroup(title="This machine")
        info.add(self._row("Model", self.machine.describe()))
        info.add(self._row("Kernel", self.machine.kernel))
        if not self.machine.is_chromebook:
            r = self._row("Warning",
                          "This does not look like a Chromebook. Fixes are "
                          "matched on hardware and most will not apply.")
            r.add_css_class("warning")
            info.add(r)
        page.add(info)

        # One row, no group title: the row says what it is, and a heading above
        # a single row reads as an empty section.
        fixes_group = Adw.PreferencesGroup()
        self._fixes_row = Adw.ActionRow(
            title="Hardware fixes", subtitle="checking…", activatable=True)
        self._fixes_row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
        self._fixes_row.connect("activated", lambda _r: self._open_fixes())
        fixes_group.add(self._fixes_row)
        page.add(fixes_group)

        # Kept so the window can be sized from what is actually on the page.
        self._root_page = page
        self._root_groups = [nf, nf_settings, kernels, backups, *grub_settings,
                             info, fixes_group]

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self._root_header = header
        refresh = Gtk.Button(icon_name="view-refresh-symbolic",
                             tooltip_text="Re-check everything")
        refresh.connect("clicked", lambda _b: self.refresh_all())
        header.pack_start(refresh)
        toolbar.add_top_bar(header)
        toolbar.set_content(Gtk.ScrolledWindow(child=page, vexpand=True))

        return Adw.NavigationPage(child=toolbar, title="Nightfall")

    def _build_kernels(self):
        """
        Every kernel installed here, which one Nightfall boots first, and a way
        to remove one.

        Removing is the only thing in this window that can leave the machine
        unable to boot, so the button is missing rather than disabled-looking
        where it must not be used: the running kernel and the last one.
        """
        self._kernels_group = Adw.PreferencesGroup(
            title="Kernels",
            description="What is installed, and which one Nightfall boots "
                        "first. Removing one frees its modules and initrd too.")

        install_row = Adw.ActionRow(
            title="Install a kernel",
            subtitle="From a tarball holding boot/vmlinuz-<release> and "
                     "lib/modules/<release>/ - a BobZKernel portable "
                     "installer works as-is.")
        install_row.set_subtitle_lines(0)
        install_btn = Gtk.Button(label="Choose file…", valign=Gtk.Align.CENTER)
        install_btn.connect("clicked", lambda _b: self._pick_kernel_tarball())
        install_row.add_suffix(install_btn)
        self._kernels_group.add(install_row)

        self._kernel_rows = []
        self._kernels_hint = Adw.ActionRow(title="Looking for installed kernels…")
        self._kernels_group.add(self._kernels_hint)
        return self._kernels_group

    def _pick_kernel_tarball(self):
        tar_filter = Gtk.FileFilter(name="Kernel tarball (*.tar.gz, *.tgz)")
        tar_filter.add_pattern("*.tar.gz")
        tar_filter.add_pattern("*.tgz")
        filters = Gio.ListStore.new(Gtk.FileFilter)
        filters.append(tar_filter)
        dialog = Gtk.FileDialog(title="Choose a kernel tarball", filters=filters,
                                default_filter=tar_filter)

        def chosen(dlg, result):
            try:
                gfile = dlg.open_finish(result)
            except GLib.Error:
                return                    # cancelled
            path = gfile.get_path()
            if path:
                self._confirm_install_kernel(path)
        dialog.open(self, None, chosen)

    def _confirm_install_kernel(self, path):
        name = Path(path).name
        dialog = Adw.MessageDialog(
            transient_for=self, modal=True,
            heading=f"Install {name}?",
            body="Extracts the kernel and its modules, then rebuilds the "
                "initramfs and GRUB's menu - a few minutes, mostly reading "
                "and writing to the disk this runs from. Do not power off "
                "while it runs.\n\nAdditive: every other installed kernel "
                "is left exactly as it is, including the one you would fall "
                "back to if something goes wrong.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Install")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.SUGGESTED)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r:
                       self._install_kernel(path) if r == "go" else None)
        dialog.present()

    def _install_kernel(self, path):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"install kernel from {Path(path).name}",
                            [cli, "--no-colour", "kernels", "--install", path],
                            stream=True, refresh_after=True)

    @staticmethod
    def _scan_kernels():
        """[(release, bytes, package, flags, kind)] - runs off the GUI thread."""
        script = REPO / "lib" / "kernels.sh"
        try:
            out = subprocess.run([str(script), "list", "--tab"], text=True,
                                 capture_output=True, env=askpass_env(), timeout=60)
        except (OSError, subprocess.SubprocessError):
            return []
        rows = []
        for line in out.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) >= 5:
                rows.append(parts[:5])
        return rows

    def _publish_kernels(self, entries):
        for row in self._kernel_rows:
            self._kernels_group.remove(row)
        self._kernel_rows = []

        if not entries:
            self._kernels_hint.set_title("No kernels found")
            self._kernels_hint.set_subtitle(
                "Nothing matching /boot/vmlinuz-* - unusual enough that it is "
                "probably worth looking at from a terminal.")
            self._kernels_hint.set_subtitle_lines(0)
            self._kernels_hint.set_visible(True)
            return False
        self._kernels_hint.set_visible(False)

        installed = [e for e in entries if e[4] == "kernel"]
        for release, size, package, flags, kind in entries:
            size = int(size) if size.isdigit() else 0
            human = (f"{size / 1e9:.1f} GB" if size >= 1e9 else f"{size / 1e6:.0f} MB")
            flag_set = set(f for f in flags.split(",") if f)
            if kind == "modules":
                subtitle = f"{human} · modules left behind, no kernel installed for them"
            else:
                who = package or "installed by hand"
                notes = []
                if "running" in flag_set:
                    notes.append("running now")
                if "default" in flag_set:
                    notes.append("Nightfall boots this first")
                if "no-initrd" in flag_set:
                    notes.append("no initrd")
                subtitle = f"{human} · {who}"
                if notes:
                    subtitle += " · " + " · ".join(notes)
            row = Adw.ActionRow(title=release, subtitle=subtitle)
            row.set_subtitle_lines(0)
            if kind == "modules":
                row.add_css_class("warning")

            box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            if kind == "kernel" and "default" not in flag_set:
                pick = Gtk.Button(label="Boot first", valign=Gtk.Align.CENTER)
                pick.set_tooltip_text("Make this the kernel Nightfall boots by default")
                pick.connect("clicked", lambda _b, r=release: self._set_default_kernel(r))
                box.append(pick)
            # No Remove where it must not happen. A greyed-out button invites a
            # click and explains nothing; the subtitle already says why.
            removable = kind == "modules" or (
                "running" not in flag_set and len(installed) > 1)
            if removable:
                rm = Gtk.Button(label="Remove", valign=Gtk.Align.CENTER)
                rm.add_css_class("destructive-action")
                rm.connect("clicked",
                           lambda _b, r=release, h=human, k=kind, p=package:
                           self._confirm_remove_kernel(r, h, k, p))
                box.append(rm)
            row.add_suffix(box)
            self._kernels_group.add(row)
            self._kernel_rows.append(row)
        return False

    def _set_default_kernel(self, release):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"default kernel {release}",
                            [cli, "--no-colour", "kernels", "--default", release],
                            stream=False, refresh_after=True)

    def _confirm_remove_kernel(self, release, human, kind, package):
        if kind == "modules":
            body = (f"{human} of modules with no kernel installed for them. "
                    f"Nothing boots these; removing them only frees the space.")
        elif package:
            body = (f"{human}, owned by {package}. It will be removed with apt, "
                    f"along with its modules and headers packages.\n\n"
                    f"You will not be able to boot it again without reinstalling it.")
        else:
            body = (f"{human}, installed by hand. Its kernel, initrd and modules "
                    f"will be deleted and the GRUB menu rebuilt.\n\n"
                    f"Nothing here can put it back: it would have to be built or "
                    f"installed again.")
        dialog = Adw.MessageDialog(
            transient_for=self, modal=True,
            heading=f"Remove {release}?", body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Remove")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r:
                       self._remove_kernel(release) if r == "go" else None)
        dialog.present()

    def _remove_kernel(self, release):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"remove kernel {release}",
                            [cli, "--no-colour", "kernels", "--remove", release, "--yes"],
                            stream=True, refresh_after=True)

    def _build_backups(self):
        """
        The backups Nightfall has taken, with a way to delete one.

        Taking and restoring stay in Nightfall, which does both with the real
        root mounted read-only - a backup of a running system catches it
        mid-write, and a restore would overwrite the system performing it.
        Seeing them and freeing space is safe from here, and it is the part
        that is otherwise a reboot into the boot manager.
        """
        self._backups_group = Adw.PreferencesGroup(
            title="Backups",
            description="Taken by Nightfall onto an external drive. "
                        "Nightfall takes and restores them; this frees space.")
        self._backup_rows = []
        self._backups_hint = Adw.ActionRow(title="Checking for backup drives…")
        self._backups_group.add(self._backups_hint)
        return self._backups_group

    @staticmethod
    def _scan_backups():
        """[(dir, name, bytes, created, kernel, state)] - runs off the GUI thread."""
        script = REPO / "lib" / "nightfall-backups.sh"
        try:
            out = subprocess.run([str(script), "list", "--tab"], text=True,
                                 capture_output=True, env=askpass_env(), timeout=30)
        except (OSError, subprocess.SubprocessError):
            return []
        rows = []
        for line in out.stdout.splitlines():
            parts = line.split("\t")
            if len(parts) >= 6:
                rows.append(parts[:6])
        return rows

    def _publish_backups(self, entries):
        """Rebuild the group from a scan. On the GUI thread."""
        for row in self._backup_rows:
            self._backups_group.remove(row)
        self._backup_rows = []

        if not entries:
            self._backups_hint.set_title("No backups found")
            self._backups_hint.set_subtitle(
                "Nightfall writes them to a folder called nocturne-backups on an "
                "external drive. Plug that drive in - if the desktop does not mount "
                "it by itself, open it in Files once.")
            self._backups_hint.set_subtitle_lines(0)
            self._backups_hint.set_visible(True)
            return False
        self._backups_hint.set_visible(False)

        for directory, name, size, created, kernel, state in entries:
            size = int(size) if size.isdigit() else 0
            human = (f"{size / 1e9:.1f} GB" if size >= 1e9 else
                     f"{size / 1e6:.0f} MB" if size >= 1e6 else f"{size / 1e3:.0f} kB")
            if state == "incomplete":
                # Nightfall's own list hides these, which is how they come to
                # sit on a drive unnoticed - and they are usually the largest
                # thing on it, so this is the one worth pointing at.
                subtitle = (f"{human} · never finished, so nothing can be restored "
                            f"from it · {directory}")
            else:
                detail = f" · {kernel}" if kernel and kernel != "unknown" else ""
                subtitle = f"{human} · {created}{detail} · {directory}"
            row = Adw.ActionRow(title=name, subtitle=subtitle)
            row.set_subtitle_lines(0)
            if state == "incomplete":
                row.add_css_class("warning")
            delete = Gtk.Button(label="Delete", valign=Gtk.Align.CENTER)
            delete.add_css_class("destructive-action")
            delete.connect("clicked",
                           lambda _b, d=directory, n=name, h=human, st=state:
                           self._confirm_delete_backup(d, n, h, st))
            row.add_suffix(delete)
            self._backups_group.add(row)
            self._backup_rows.append(row)
        return False

    def _confirm_delete_backup(self, directory, name, human, state):
        body = (f"{human} on {directory}.\n\nThis cannot be undone.")
        if state == "incomplete":
            body = (f"{human} on {directory}.\n\nThis backup never finished, so "
                    f"nothing can be restored from it - deleting it only frees "
                    f"the space. This cannot be undone.")
        dialog = Adw.MessageDialog(
            transient_for=self, modal=True,
            heading=f"Delete {name}?", body=body)
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Delete")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        # Cancel on Enter and on Escape: a stray keypress must never destroy
        # the thing you keep for when everything else has gone wrong.
        dialog.set_default_response("cancel")
        dialog.set_close_response("cancel")
        dialog.connect("response", lambda _d, r:
                       self._delete_backup(directory, name) if r == "go" else None)
        dialog.present()

    def _delete_backup(self, directory, name):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"delete backup {name}",
                            [cli, "--no-colour", "backups", "--delete", name,
                             "--dir", directory, "--yes"],
                            stream=False, refresh_after=True)

    def _push(self, page, title):
        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())     # back button is automatic
        toolbar.set_content(Gtk.ScrolledWindow(child=page, vexpand=True))
        self.nav.push(Adw.NavigationPage(child=toolbar, title=title))

    # -- level 2: the categories -------------------------------------------

    def _build_fixes_page(self):
        """
        The category list, built but not shown and not checked.

        Built fresh every time, like a category page, so the copy measured for
        sizing never becomes the copy that refresh writes to.
        """
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup(
            title="Fixes",
            description="Pick the part of the machine you want to look at. "
                        "Nothing is changed until you press Apply.")
        rows = {}
        for key, label in CATEGORIES.items():
            fixes = self.fixes_by_category.get(key)
            if not fixes:
                continue
            # The summary from the start, not only once a refresh runs: this
            # page is measured to size the window, and it has to be measured
            # with the text it will actually carry.
            subtitle, _warn = self._category_summary(fixes)
            row = Adw.ActionRow(title=label, subtitle=subtitle, activatable=True)
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated",
                        lambda _r, k=key, l=label: self._open_category(k, l))
            group.add(row)
            rows[key] = (row, fixes)
        page.add(group)
        return page, [group], rows

    def _open_fixes(self):
        page, _groups, rows = self._build_fixes_page()
        # Only the page actually on screen becomes what refresh updates.
        # Painting from the cache, not re-checking: this page used to run every
        # fix's detect and verify as it opened, which froze the window.
        self.category_rows = rows
        self._refresh_categories()
        self._push(page, "Hardware fixes")

    # -- level 3: one category ---------------------------------------------

    def _build_category_page(self, key, label):
        """
        One category's page, built but not shown and not checked.

        Separate from _open_category so the window can measure a page before
        it is ever opened. FixRows come up with their id as the subtitle and
        run no detection until refreshed, so building one is cheap and it is
        already the height it will be on screen.
        """
        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup()
        rows = []
        for fix in self.fixes_by_category.get(key, ()):
            row = FixRow(fix, self)
            # From the cache, so a page is measured at the height it will have
            # once opened - a FixRow's subtitle grows from the fix id to the
            # first line of its detail, which is taller.
            row.refresh()
            rows.append(row)
            group.add(row)
        page.add(group)
        return page, [group], rows

    def _open_category(self, key, label):
        page, _groups, rows = self._build_category_page(key, label)
        for row in rows:
            self.rows.append(row)
            row.refresh()
        self._push(page, label)

    # -- summaries ----------------------------------------------------------

    # -- boot menus --------------------------------------------------------

    NF_TIMEOUT_FILE = "/boot/nightfall-timeout"
    NF_ROTATE_FILE = "/boot/nightfall-rotate"
    NF_AUTOROTATE_FILE = "/boot/nightfall-autorotate"
    NF_DEFAULT_TIMEOUT = 30      # DEFAULT_TIMEOUT_SECS in ui/nightfall.c, 34cb3bc
    NF_DEFAULT_ROTATE = "270"    # init: ': "${NIGHTFALL_ROTATE:=270}"'
    NF_SPLASH_FILE = "/boot/nightfall-splash"          # Nightfall 8bb40ea
    NF_SPLASH_MS_FILE = "/boot/nightfall-splash-ms"
    NF_DEFAULT_SPLASH_MS = 1500
    SPLASH_FLICKER_MS = 300      # below this the spinner lasts only ~0.2s of work
    ROTATIONS = ("0", "90", "180", "270")

    @staticmethod
    def _first_line(path):
        """
        A file's first line as Nightfall's init reads it - `read -r` with the
        default IFS strips surrounding spaces, tabs and the newline, and
        nothing else. None when there is no such file.

        Every value in this group is what Nightfall will USE, not what its
        file says. Nightfall ignores a file it cannot parse, so showing the
        raw contents of a garbage file would describe a setting not in effect.
        """
        try:
            with open(path) as f:
                return f.readline().strip(" \t\n")
        except OSError:
            return None

    @staticmethod
    def _source_note(source):
        return {"file": "", "default": " (default)",
                "ignored": " (default - the file on /boot was not valid)"}[source]

    @staticmethod
    def _grub_timeout():
        try:
            for line in open("/etc/default/grub"):
                if line.startswith("GRUB_TIMEOUT="):
                    v = line.split("=", 1)[1].split("#")[0].strip().strip('"')
                    return int(v)
        except (OSError, ValueError):
            pass
        return None

    @classmethod
    def _nightfall_timeout(cls):
        v = cls._first_line(cls.NF_TIMEOUT_FILE)
        if v is None:
            return cls.NF_DEFAULT_TIMEOUT, "default"
        # Digits only and at most 3600, as init checks. The previous int()
        # accepted "-5" and "4000" and displayed them as the setting, when
        # Nightfall ignores both and uses its default.
        if v.isascii() and v.isdigit() and int(v) <= 3600:
            return int(v), "file"
        return cls.NF_DEFAULT_TIMEOUT, "ignored"

    @classmethod
    def _nightfall_rotation(cls):
        v = cls._first_line(cls.NF_ROTATE_FILE)
        if v is None:
            return cls.NF_DEFAULT_ROTATE, "default"
        return (v, "file") if v in cls.ROTATIONS else (cls.NF_DEFAULT_ROTATE, "ignored")

    @classmethod
    def _nightfall_autorotate(cls):
        v = cls._first_line(cls.NF_AUTOROTATE_FILE)
        if v is None:
            return True, "default"
        if v in ("1", "on"):
            return True, "file"
        if v in ("0", "off"):
            return False, "file"
        return True, "ignored"          # garbage keeps auto-rotate on

    @classmethod
    def _nightfall_splash(cls):
        v = cls._first_line(cls.NF_SPLASH_FILE)
        if v is None:
            return True, "default"
        if v in ("1", "on"):
            return True, "file"
        if v in ("0", "off"):
            return False, "file"
        return True, "ignored"          # only exactly 0/off turns them off

    @classmethod
    def _nightfall_splash_ms(cls):
        v = cls._first_line(cls.NF_SPLASH_MS_FILE)
        if v is None:
            return cls.NF_DEFAULT_SPLASH_MS, "default"
        if v.isascii() and v.isdigit() and int(v) <= 10000:
            return int(v), "file"
        return cls.NF_DEFAULT_SPLASH_MS, "ignored"

    @staticmethod
    def _nightfall_installed():
        """
        Is Nightfall on this machine at all - by the same test its fix's verify
        uses: the marked entry in custom.cfg, and its files on /boot. Installed
        by hand counts too; these are Nightfall's settings, not the fix's.
        """
        import os
        try:
            with open("/boot/grub/custom.cfg") as f:
                cfg = f.read()
        except OSError:
            return False
        marked = any(f"### BEGIN {n} ###" in cfg
                     for n in ("nightfall-boot-manager", "nocturne-boot-picker"))
        return marked and any(os.path.isdir(d) for d in ("/boot/nightfall", "/boot/picker"))

    def _build_boot_settings(self):
        """
        Booting and recovery's settings: Nightfall's, then GRUB's.

        They live on this page rather than the root one because everything
        about booting belongs in one place, in the order it is used: install
        Nightfall, make it the default, tune it, and GRUB beneath as the
        fallback. The root page is a list of places to go, not a panel.

        Nightfall's group shows one line instead of its rows until Nightfall is
        installed - on a machine without it they configure nothing. GRUB's
        stands on its own: its menu wait applies either way, and it is still
        how a keyboard reaches GRUB's own recovery entries.

        The timeouts stay separate rows in separate groups rather than one
        number, because the value that strands you differs. GRUB's 0 means no
        menu and boots immediately; Nightfall's 0 disables auto-boot and waits
        for a tap forever, which on a tablet whose touchscreen may be the
        broken part is the unrecoverable one.

        Returns (groups, handles). Handles are only kept for a page that is
        actually opened; see _open_category.
        """
        installed = self._nightfall_installed()
        h = {"timeout_rows": []}

        def timeout_row(key, title, low, note):
            row = Adw.ActionRow(title=title, subtitle=note)
            spin = Gtk.SpinButton.new_with_range(low, 3600, 1)
            spin.set_valign(Gtk.Align.CENTER)
            btn = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
            btn.connect("clicked",
                        lambda _b, k=key, sp=spin: self._set_timeout(k, sp))
            box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            box.append(spin)
            box.append(btn)
            row.add_suffix(box)
            h["timeout_rows"].append((key, row, spin, note))
            return row

        nf = Adw.PreferencesGroup(
            title="Nightfall settings",
            description="What Nightfall does on its own. "
                        "Takes effect on the next boot through it.")
        h["hint"] = Adw.ActionRow(
            title="Nightfall is not installed",
            subtitle="Install it above - its settings appear here once it is.")
        nf.add(h["hint"])

        # Chosen and then Set rather than applied on change: every change is an
        # authentication prompt, and refreshing moves these controls
        # programmatically - applying on change would turn a refresh into a write.
        h["rotate_row"] = Adw.ComboRow(
            title="Starting rotation", subtitle="checking…",
            model=Gtk.StringList.new([f"{r}°" for r in self.ROTATIONS]))
        rot_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        rot_set.connect("clicked", lambda _b: self._run_boot_menu(
            "rotate", self.ROTATIONS[h["rotate_row"].get_selected()]))
        h["rotate_row"].add_suffix(rot_set)

        h["autorotate_row"] = Adw.ComboRow(
            title="Auto-rotate", subtitle="checking…",
            model=Gtk.StringList.new(["On", "Off"]))
        auto_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        auto_set.connect("clicked", lambda _b: self._run_boot_menu(
            "autorotate", ("on", "off")[h["autorotate_row"].get_selected()]))
        h["autorotate_row"].add_suffix(auto_set)

        # Boot screens: the startup spinner and "Booting <entry>" together.
        # Cosmetic, so no confirmation anywhere - only hints.
        h["splash_row"] = Adw.ComboRow(
            title="Boot screens", subtitle="checking…",
            model=Gtk.StringList.new(["On", "Off"]))
        splash_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        splash_set.connect("clicked", lambda _b: self._run_boot_menu(
            "splash", ("on", "off")[h["splash_row"].get_selected()]))
        h["splash_row"].add_suffix(splash_set)

        h["splash_ms_row"] = Adw.ActionRow(title="Boot screen time",
                                           subtitle="checking…")
        # Seconds in quarter steps; the file on /boot stays in milliseconds.
        # Typed values between steps are kept rather than snapped, so a
        # hand-set 1.6 s is shown and re-saved as it is.
        h["splash_ms_spin"] = Gtk.SpinButton.new_with_range(0, 10, 0.25)
        h["splash_ms_spin"].set_digits(2)
        h["splash_ms_spin"].set_valign(Gtk.Align.CENTER)
        ms_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        ms_set.connect("clicked", lambda _b: self._run_boot_menu(
            "splash-ms", round(h["splash_ms_spin"].get_value() * 1000)))
        ms_box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        ms_box.append(h["splash_ms_spin"])
        ms_box.append(ms_set)
        h["splash_ms_row"].add_suffix(ms_box)

        h["nightfall_rows"] = [
            timeout_row("nightfall", "Menu timeout", 0,
                        "0 never auto-boots - it waits for a tap forever"),
            h["rotate_row"],
            h["autorotate_row"],
            h["splash_row"],
            h["splash_ms_row"],
        ]
        for row in h["nightfall_rows"]:
            nf.add(row)

        grub = Adw.PreferencesGroup(
            title="GRUB",
            description="How long GRUB's own menu waits before booting its default.")
        grub.add(timeout_row("grub", "Menu timeout", -1,
                             "-1 waits forever; 0 skips the menu entirely"))

        # Applied here as well as on refresh, so a page measured before it is
        # opened is measured with the rows that will actually show.
        h["hint"].set_visible(not installed)
        for row in h["nightfall_rows"]:
            row.set_visible(installed)
        return [nf, grub], h

    def _refresh_boot_menu(self):
        h = getattr(self, "boot", None)
        if h is None:                  # Booting and recovery not opened yet
            return
        installed = self._nightfall_installed()
        h["hint"].set_visible(not installed)
        for row in h["nightfall_rows"]:
            row.set_visible(installed)

        for key, row, spin, note in h["timeout_rows"]:
            if key == "grub":
                value = self._grub_timeout()
                row.set_subtitle(f"{value}s — {note}" if value is not None
                                 else f"unset — {note}")
                spin.set_value(5 if value is None else value)
            else:
                value, source = self._nightfall_timeout()
                row.set_subtitle(f"{value}s{self._source_note(source)} — {note}")
                # Parks on the value in effect, never on 0 for "unset": 0 is a
                # real and, for Nightfall, dangerous setting.
                spin.set_value(value)

        rot, rsource = self._nightfall_rotation()
        auto, asource = self._nightfall_autorotate()
        h["rotate_row"].set_selected(self.ROTATIONS.index(rot))
        h["autorotate_row"].set_selected(0 if auto else 1)
        if auto:
            h["rotate_row"].set_subtitle(
                f"starts at {rot}°{self._source_note(rsource)} — auto-rotate "
                f"takes over within about 750ms")
            h["autorotate_row"].set_subtitle(
                f"on{self._source_note(asource)} — follows the accelerometer")
        else:
            h["rotate_row"].set_subtitle(
                f"stays at {rot}°{self._source_note(rsource)} — auto-rotate "
                f"is off, so this pins it")
            h["autorotate_row"].set_subtitle(
                f"off{self._source_note(asource)} — Nightfall keeps its "
                f"starting rotation")

        splash, ssource = self._nightfall_splash()
        ms, msource = self._nightfall_splash_ms()
        h["splash_row"].set_selected(0 if splash else 1)
        h["splash_ms_spin"].set_value(ms / 1000)
        secs = f"{ms / 1000:g} s"
        if splash:
            h["splash_row"].set_subtitle(
                f"on{self._source_note(ssource)} — spinner until the menu, "
                f"then “Booting …” until the kernel takes over")
            note = ("under 0.3 s the spinner reads as a flicker"
                    if ms < self.SPLASH_FLICKER_MS else
                    "time already on screen counts; a slow handoff stays longer")
            h["splash_ms_row"].set_subtitle(
                f"at least {secs}{self._source_note(msource)} — {note}")
        else:
            h["splash_row"].set_subtitle(
                f"off{self._source_note(ssource)} — the screen stays black "
                f"while Nightfall starts and hands off")
            h["splash_ms_row"].set_subtitle(
                f"{secs}{self._source_note(msource)} — does nothing while "
                f"boot screens are off")

    def _run_boot_menu(self, flag, value, extra=()):
        cli = str(REPO / "bin" / "chromebook-fixer")
        cmd = [cli, "--no-colour", "boot-menu", f"--{flag}", str(value), *extra]
        self._run_in_window(f"boot-menu {flag}", cmd,
                            stream=False, refresh_after=True)

    def _set_timeout(self, key, spin):
        value = int(spin.get_value())
        if key == "nightfall" and value == 0:
            # The CLI refuses this without -y. Ask the same question here
            # rather than passing -y silently, and say what it actually does -
            # "0" reads like "no wait", and it means the opposite.
            dialog = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading="Never auto-boot?",
                body="0 does not boot immediately. It disables Nightfall's "
                     "auto-boot, so the menu waits for a tap forever. "
                     "If the touchscreen ever fails, this machine has no "
                     "keyboard to get past it.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("go", "Set anyway")
            dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
            # Cancel on Enter and on Escape. The dangerous answer should never
            # be the one a stray keypress or a dismissed dialog produces.
            dialog.set_default_response("cancel")
            dialog.set_close_response("cancel")
            dialog.connect("response", lambda _d, r: (
                self._run_boot_menu(key, value, ("--yes",))
                if r == "go" else None))
            dialog.present()
            return
        self._run_boot_menu(key, value)

    def status_of(self, fix):
        """What the last sweep found for a fix, or None if it has not run yet."""
        return self._status.get(fix.id)

    def refresh_all(self):
        """
        Re-check everything, off the GUI thread.

        Each status() runs the fix's verify and detect scripts - two
        subprocesses, twenty-odd fixes - and this used to happen on the main
        thread, so the window locked up while it ran. Opening Hardware fixes
        made it worse by starting a second full sweep, once for the category
        counts and again for the row that counts every fix behind it.

        Now one background thread walks every fix and publishes each result as
        it lands, so rows fill in progressively and the window stays live. A
        sweep asked for while one is running is remembered, not stacked: an
        apply finishing mid-sweep must still re-check, but two sweeps at once
        would double the subprocesses for nothing.
        """
        self._refresh_boot_menu()          # file reads only, cheap enough here
        if self._sweeping:
            self._resweep = True
            return False
        self._sweeping = True

        def worker():
            while True:
                for fix in self._all_fixes:
                    GLib.idle_add(self._publish, fix.id, fix.status())
                # Kernels and backups in this thread too: both read the
                # disk - du over module trees, a drive that may be spun down -
                # which is not something to do on the GUI thread for the sake
                # of a subtitle.
                GLib.idle_add(self._publish_kernels, self._scan_kernels())
                GLib.idle_add(self._publish_backups, self._scan_backups())
                if not self._resweep:
                    break
                self._resweep = False
            GLib.idle_add(self._sweep_done)

        import threading
        threading.Thread(target=worker, daemon=True).start()
        return False

    def _publish(self, fix_id, result):
        """One fix's result, on the GUI thread."""
        self._status[fix_id] = result
        for row in self.rows:
            if row.fix.id == fix_id:
                row.show_status(*result)
        self._refresh_categories()
        return False

    def _sweep_done(self):
        self._sweeping = False
        self._refit()
        return False

    HEIGHT_FILE = Path(GLib.get_user_cache_dir()) / "chromebook-fixer" / "window-height"

    def _remembered_height(self):
        """
        The height the last run settled on, or None.

        Only ever a starting point: _refit measures again and corrects it, so a
        stale number costs one resize rather than a wrong window forever.
        """
        try:
            value = int(self.HEIGHT_FILE.read_text().strip())
        except (OSError, ValueError):
            return None
        cap = self._screen_cap_height()
        return value if 600 <= value <= cap else None

    def _remember_height(self, height):
        try:
            self.HEIGHT_FILE.parent.mkdir(parents=True, exist_ok=True)
            self.HEIGHT_FILE.write_text(f"{height}\n")
        except OSError:
            pass          # a window that cannot remember its size still works

    def _refit(self):
        """
        Grow the window once, after the first sweep, if the page outgrew the
        size it opened at.

        The opening size is measured before any fix has been checked, because
        checking takes seconds and the window has to appear now. But detection
        is what makes the rows tall: a FixRow's subtitle starts as the fix id
        and becomes "id — <first line of detail>", which wraps, and the same
        goes for every count and settings row. The estimate was a smidge short
        of what the page then needed, so the last group sat just off the
        bottom. Measuring again once the real text is in place is the only
        honest fix; the alternative is guessing at text that does not exist yet.

        Once only, and only ever taller, so this cannot fight a window the user
        has deliberately made small.
        """
        if self._fitted:
            return
        self._fitted = True
        want = self._fit_to_content()
        if self.get_height() not in (0, self._set_height):
            return        # the user has already resized it; leave it alone
        if want != self._set_height:
            self._set_height = want
            self.set_default_size(760, want)
        self._remember_height(want)

    def _refresh_categories(self):
        """
        Summaries for every row that stands for fixes underneath it: the
        category rows when that page is open, and home's Hardware fixes row,
        which counts every fix behind it whether or not its page was ever
        opened. Counting here rather than on the rows keeps the status check in
        one place, and means nothing can look calm while something inside it
        needs attention.
        """
        for _key, (row, fixes) in self.category_rows.items():
            subtitle, warn = self._category_summary(fixes)
            row.set_subtitle(subtitle)
            if warn:
                row.remove_css_class("dim-label")

        every = [f for fixes in self.fixes_by_category.values() for f in fixes]
        subtitle, warn = self._category_summary(every, lead="camera, display, "
                                                "audio and the rest — ")
        self._fixes_row.set_subtitle(subtitle)
        if warn:
            self._fixes_row.add_css_class("warning")
        else:
            self._fixes_row.remove_css_class("warning")

    def _category_summary(self, fixes, lead=""):
        """
        (subtitle, needs attention) for a row standing in for several fixes.

        Counted from the cache, never by running detection: this is called
        while building pages as well as while refreshing them.
        """
        needed = applied = checked = 0
        for fix in fixes:
            found = self._status.get(fix.id)
            if found is None:
                continue
            checked += 1
            if found[0] == "needed":
                needed += 1
            elif found[0] == "applied":
                applied += 1
        total = len(fixes)
        if needed:
            return f"{lead}{needed} of {total} need attention", True
        if checked < total:
            return f"checking… ({checked} of {total})", False
        return (f"{lead}nothing needed, {applied} applied" if lead else
                f"{total} fix{'es' if total != 1 else ''}, {applied} applied"), False

    @staticmethod
    def _row(title, subtitle):
        r = Adw.ActionRow(title=title, subtitle=subtitle)
        r.set_subtitle_lines(0)
        return r

    # -- running a fix ----------------------------------------------------

    def run_action(self, action, fix):
        """Confirm first for anything risky, then run it in a live output window."""
        if action == "apply" and (fix.risk == "high" or fix.danger):
            self._confirm(action, fix)
        else:
            self._execute(action, fix)

    def _confirm(self, action, fix):
        body = fix.danger or fix.notes or ""
        if not fix.reverts_cleanly:
            body += "\n\nThis fix cannot be cleanly reverted."
        dialog = Adw.MessageDialog(
            transient_for=self, heading=f"Apply {fix.name}?",
            body=body.strip() or "This will change system configuration.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Apply")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.connect("response", lambda _d, r:
                       self._execute(action, fix) if r == "go" else None)
        dialog.present()

    def _execute(self, action, fix):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"{action} {fix.id}",
                            [cli, "--no-colour", action, fix.id, "--yes"])

    def view_logs(self, fix):
        """
        Show a fix's own log.

        Read in one go rather than streamed. Streaming is right for apply,
        which is slow and where watching it matters; a log is already written,
        and Nightfall's runs past a thousand lines - pushing those through the
        main loop one idle callback at a time is visibly slow on the hardware
        this runs on.
        """
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"logs {fix.id}",
                            [cli, "--no-colour", "logs", fix.id],
                            stream=False, refresh_after=False)

    def _run_in_window(self, title, cmd, stream=True, refresh_after=True):
        win = Adw.Window(transient_for=self, modal=True,
                         default_width=680, default_height=440,
                         title=title)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        buf = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=buf, editable=False, monospace=True,
                            wrap_mode=Pango.WrapMode.WORD_CHAR)
        tv.set_content(Gtk.ScrolledWindow(child=view, vexpand=True))
        close = Gtk.Button(label="Close", margin_top=6, margin_bottom=6,
                           margin_start=12, margin_end=12, sensitive=False)
        close.connect("clicked", lambda _b: win.close())
        tv.add_bottom_bar(close)
        win.set_content(tv)
        win.present()

        def append(text):
            buf.insert(buf.get_end_iter(), text)
            return False

        append(f"$ {' '.join(cmd)}\n\n")

        def worker():
            try:
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, env=askpass_env())
                if stream:
                    for line in proc.stdout:
                        GLib.idle_add(append, line)
                    proc.wait()
                else:
                    out = proc.stdout.read()
                    proc.wait()
                    GLib.idle_add(append, out)
                GLib.idle_add(append, f"\n[finished, exit {proc.returncode}]\n")
            except Exception as exc:                      # noqa: BLE001
                GLib.idle_add(append, f"\nfailed to run: {exc}\n")
            GLib.idle_add(close.set_sensitive, True)
            if refresh_after:
                GLib.idle_add(self.refresh_all)

        import threading
        threading.Thread(target=worker, daemon=True).start()


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.chromebookfixer.Gui")

    def do_activate(self):
        Window(self).present()


if __name__ == "__main__":
    sys.exit(Application().run(None))
