#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""chromebook-fixer-gui — a window over the chromebook-fixer CLI.

Deliberately a front-end, not a reimplementation: it shells out to the same
CLI, so detection, safety gating and the fix lifecycle have exactly one
implementation. Anything the GUI can do, the CLI can do, and they cannot drift.
"""

import os
import subprocess
import sys
from pathlib import Path

import gi

gi.require_version("Gtk", "4.0")
gi.require_version("Adw", "1")
from gi.repository import Adw, Gdk, GLib, Gtk, Pango  # noqa: E402

REPO = Path(__file__).resolve().parent.parent
sys.path.insert(0, str(REPO / "lib"))
from registry import CATEGORIES, Machine, load_fixes  # noqa: E402

RISK_STYLE = {"low": "success", "medium": "warning", "high": "error"}
STATE_TEXT = {
    "applied": ("Applied", "success"),
    "needed": ("Needed", "warning"),
    "ok": ("Not needed", "dim-label"),
    "unknown": ("Unknown", "dim-label"),
}


def askpass_env():
    """
    Fix scripts escalate as root, and there is no terminal here to type a
    password into. Rather than decide how, tell the CLI it has no tty and let
    registry.sudo_command() choose: pkexec, so the desktop's polkit agent
    authenticates however the machine is set up to - a fingerprint reader,
    typically - falling back to `sudo -A` and a graphical askpass helper.
    (Setting SUDO_ASKPASS alone would not be enough: sudo reads it only when
    invoked as `sudo -A`.)

    Announcing it rather than letting the CLI probe for /dev/tty matters when
    the GUI is launched *from* a terminal: that tty exists but the user is
    looking at this window, so a prompt there would look like a hang.
    """
    env = dict(os.environ)
    env["FIXER_NO_TTY"] = "1"
    return env


class FixRow(Adw.ExpanderRow):
    def __init__(self, fix, window):
        super().__init__(title=fix.name, subtitle=fix.id)
        self.fix = fix
        self.window = window

        self.state_label = Gtk.Label(label="checking…")
        self.state_label.add_css_class("dim-label")
        self.add_suffix(self.state_label)

        risk = Gtk.Label(label=fix.risk)
        risk.add_css_class(RISK_STYLE.get(fix.risk, "dim-label"))
        risk.add_css_class("caption")
        self.add_suffix(risk)

        if fix.description:
            self.add_row(self._text_row(fix.description))
        if fix.danger:
            warn = self._text_row(fix.danger)
            warn.add_css_class("error")
            self.add_row(warn)
        if not fix.reverts_cleanly:
            self.add_row(self._text_row("This fix cannot be cleanly reverted."))

        actions = Adw.ActionRow()
        box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
        self.apply_btn = Gtk.Button(label="Apply")
        self.apply_btn.add_css_class("suggested-action")
        self.apply_btn.connect("clicked", lambda _b: window.run_action("apply", fix))
        self.revert_btn = Gtk.Button(label="Revert")
        self.revert_btn.connect("clicked", lambda _b: window.run_action("revert", fix))
        box.append(self.apply_btn)
        box.append(self.revert_btn)
        # Only for fixes that keep one. Nightfall is the only one today, but
        # this asks the fix rather than naming it, so another that grows a
        # logs.sh gets the button without touching the GUI.
        if fix.has("logs"):
            logs_btn = Gtk.Button(label="Logs")
            logs_btn.set_tooltip_text("Show this fix's own diagnostic log")
            logs_btn.connect("clicked", lambda _b: window.view_logs(fix))
            box.append(logs_btn)
        actions.add_suffix(box)
        self.add_row(actions)

    @staticmethod
    def _text_row(text):
        row = Adw.ActionRow()
        label = Gtk.Label(label=text.strip(), wrap=True, xalign=0,
                          margin_top=6, margin_bottom=6)
        label.add_css_class("caption")
        row.set_child(label)
        return row

    def refresh(self):
        state, detail = self.fix.status()
        text, style = STATE_TEXT[state]
        self.state_label.set_label(text)
        for s in ("success", "warning", "dim-label"):
            self.state_label.remove_css_class(s)
        self.state_label.add_css_class(style)
        if detail:
            self.set_subtitle(f"{self.fix.id} — {detail.splitlines()[0]}")
        self.apply_btn.set_sensitive(state in ("needed", "unknown")
                                     and self.fix.has("apply"))
        self.revert_btn.set_sensitive(state == "applied" and self.fix.has("revert"))


class Window(Adw.ApplicationWindow):
    """
    Two levels: a list of categories, then the fixes inside one.

    A single page of twenty expander rows is a wall of hardware jargon, and it
    reads as intimidating rather than useful. People arrive because one thing is
    broken, so the first screen is just "which part of the machine?", and each
    category carries a count of what needs attention so nothing hides behind a
    heading.
    """

    def __init__(self, app):
        super().__init__(application=app, title="Chromebook Fixer",
                         default_width=760, default_height=self._screen_cap_height())
        self.machine = Machine.detect()
        self.rows = []              # every FixRow, for refreshing
        self.category_rows = {}     # category key -> (row, fixes)

        self.nav = Adw.NavigationView()
        self.nav.add(self._build_root())
        self.toasts = Adw.ToastOverlay(child=self.nav)
        self.set_content(self.toasts)
        # Now that the page exists, open as tall as it actually is.
        self.set_default_size(760, self._fit_to_content())

        GLib.idle_add(self.refresh_all)

    @staticmethod
    def _screen_cap_height(fallback=900):
        """
        The tallest this window should ever open: 92% of the monitor, so it
        never runs off a screen that has turned. A ceiling, not a size - see
        _fit_to_content for why.
        """
        try:
            monitors = Gdk.Display.get_default().get_monitors()
            geometry = monitors.get_item(0).get_geometry()
            return max(600, min(1300, int(geometry.height * 0.92)))
        except Exception:                                  # noqa: BLE001
            return fallback

    def _fit_to_content(self):
        """
        Open exactly as tall as the root page needs, up to the screen's cap.

        Third attempt, and the first that measures the right thing. A constant
        went stale twice as rows were added - 720, then 900, each cutting off
        the last category. Replacing it with 92% of the screen fixed "too
        small" and produced "too big": this tablet held in portrait gets 1300px
        for about 1000px of content. Both sized the window from something other
        than what is in it.

        So measure the groups actually on the page, and take the larger of
        their sum and the page's own report. Adwaita's preferences page scrolls
        internally, so its natural height can come back as the scroller's
        rather than the content's; the groups themselves do not scroll, so
        their sum is the reliable half. Groups are measured narrower than the
        window because the page clamps them - measuring wide would under-count
        the lines their descriptions wrap onto. Adding a row changes the answer
        on its own; turning the screen changes the cap.
        """
        cap = self._screen_cap_height()
        try:
            def natural(widget, width):
                return widget.measure(Gtk.Orientation.VERTICAL, width)[1]
            groups = sum(natural(g, 560) for g in self._root_groups)
            # Adwaita spaces groups apart and pads the page; allow for that
            # rather than reaching into the private box that holds them.
            body = max(natural(self._root_page, 760),
                       groups + 24 * len(self._root_groups) + 48)
            want = natural(self._root_header, 760) + body
            if want > 200:                     # a failed measure reads as ~0
                return max(600, min(cap, want))
        except Exception:                                  # noqa: BLE001
            pass
        return cap

    # -- level 1: the categories -------------------------------------------

    def _build_root(self):
        page = Adw.PreferencesPage()

        info = Adw.PreferencesGroup(title="This machine")
        info.add(self._row("Model", self.machine.describe()))
        info.add(self._row("Kernel", self.machine.kernel))
        if not self.machine.is_chromebook:
            r = self._row("Warning",
                          "This does not look like a Chromebook. Fixes are "
                          "matched on hardware and most will not apply.")
            r.add_css_class("warning")
            info.add(r)
        page.add(info)

        applicable = [f for f in load_fixes() if f.matches(self.machine)]
        group = Adw.PreferencesGroup(
            title="Fixes",
            description="Pick the part of the machine you want to look at. "
                        "Nothing is changed until you press Apply.")

        for key, label in CATEGORIES.items():
            fixes = [f for f in applicable if f.category == key]
            if not fixes:
                continue
            # A subtitle from the start, not only once refresh_all fills it in.
            # The window is sized by measuring this page before anything has
            # been checked, and a row without a subtitle is shorter - eight of
            # them measured bare would open the window too short once the
            # counts arrive.
            row = Adw.ActionRow(title=label, subtitle="checking…", activatable=True)
            row.add_suffix(Gtk.Image(icon_name="go-next-symbolic"))
            row.connect("activated",
                        lambda _r, k=key, l=label: self._open_category(k, l))
            group.add(row)
            self.category_rows[key] = (row, fixes)
        page.add(group)
        boot = self._build_boot_menu()
        page.add(boot)
        # Kept so the window can be sized from what is actually on the page.
        self._root_page = page
        self._root_groups = [info, group, boot]

        toolbar = Adw.ToolbarView()
        header = Adw.HeaderBar()
        self._root_header = header
        refresh = Gtk.Button(icon_name="view-refresh-symbolic",
                             tooltip_text="Re-check everything")
        refresh.connect("clicked", lambda _b: self.refresh_all())
        header.pack_start(refresh)
        toolbar.add_top_bar(header)
        toolbar.set_content(Gtk.ScrolledWindow(child=page, vexpand=True))

        return Adw.NavigationPage(child=toolbar, title="Chromebook Fixer")

    # -- level 2: one category ---------------------------------------------

    def _open_category(self, key, label):
        _row, fixes = self.category_rows[key]

        page = Adw.PreferencesPage()
        group = Adw.PreferencesGroup()
        for fix in fixes:
            row = FixRow(fix, self)
            self.rows.append(row)
            group.add(row)
            row.refresh()
        page.add(group)

        toolbar = Adw.ToolbarView()
        toolbar.add_top_bar(Adw.HeaderBar())     # back button is automatic
        toolbar.set_content(Gtk.ScrolledWindow(child=page, vexpand=True))
        self.nav.push(Adw.NavigationPage(child=toolbar, title=label))

    # -- summaries ----------------------------------------------------------

    # -- boot menus --------------------------------------------------------

    NF_TIMEOUT_FILE = "/boot/nightfall-timeout"
    NF_ROTATE_FILE = "/boot/nightfall-rotate"
    NF_AUTOROTATE_FILE = "/boot/nightfall-autorotate"
    NF_DEFAULT_TIMEOUT = 30      # DEFAULT_TIMEOUT_SECS in ui/nightfall.c, 34cb3bc
    NF_DEFAULT_ROTATE = "270"    # init: ': "${NIGHTFALL_ROTATE:=270}"'
    ROTATIONS = ("0", "90", "180", "270")

    @staticmethod
    def _first_line(path):
        """
        A file's first line as Nightfall's init reads it - `read -r` with the
        default IFS strips surrounding spaces, tabs and the newline, and
        nothing else. None when there is no such file.

        Every value in this group is what Nightfall will USE, not what its
        file says. Nightfall ignores a file it cannot parse, so showing the
        raw contents of a garbage file would describe a setting not in effect.
        """
        try:
            with open(path) as f:
                return f.readline().strip(" \t\n")
        except OSError:
            return None

    @staticmethod
    def _source_note(source):
        return {"file": "", "default": " (default)",
                "ignored": " (default - the file on /boot was not valid)"}[source]

    @staticmethod
    def _grub_timeout():
        try:
            for line in open("/etc/default/grub"):
                if line.startswith("GRUB_TIMEOUT="):
                    v = line.split("=", 1)[1].split("#")[0].strip().strip('"')
                    return int(v)
        except (OSError, ValueError):
            pass
        return None

    @classmethod
    def _nightfall_timeout(cls):
        v = cls._first_line(cls.NF_TIMEOUT_FILE)
        if v is None:
            return cls.NF_DEFAULT_TIMEOUT, "default"
        # Digits only and at most 3600, as init checks. The previous int()
        # accepted "-5" and "4000" and displayed them as the setting, when
        # Nightfall ignores both and uses its default.
        if v.isascii() and v.isdigit() and int(v) <= 3600:
            return int(v), "file"
        return cls.NF_DEFAULT_TIMEOUT, "ignored"

    @classmethod
    def _nightfall_rotation(cls):
        v = cls._first_line(cls.NF_ROTATE_FILE)
        if v is None:
            return cls.NF_DEFAULT_ROTATE, "default"
        return (v, "file") if v in cls.ROTATIONS else (cls.NF_DEFAULT_ROTATE, "ignored")

    @classmethod
    def _nightfall_autorotate(cls):
        v = cls._first_line(cls.NF_AUTOROTATE_FILE)
        if v is None:
            return True, "default"
        if v in ("1", "on"):
            return True, "file"
        if v in ("0", "off"):
            return False, "file"
        return True, "ignored"          # garbage keeps auto-rotate on

    def _build_boot_menu(self):
        """
        What each boot menu does on its own.

        Timeouts are two rows, not one: the value that strands you differs.
        GRUB's 0 means no menu and boots immediately; Nightfall's 0 disables
        auto-boot and waits for a tap forever, which on a tablet whose
        touchscreen may be the broken part is the unrecoverable one.

        Rotation and auto-rotate are separate rows because they interact. With
        auto-rotate on, the starting rotation only lasts until the first
        accelerometer reading; with it off, it is where Nightfall stays. The
        rotation row's subtitle says which of those is in effect.
        """
        group = Adw.PreferencesGroup(
            title="Boot menus",
            description="What each boot menu does on its own. "
                        "Takes effect on the next boot.")
        self.timeout_rows = []
        for key, title, low, note in (
            ("grub", "GRUB menu timeout", -1,
             "-1 waits forever; 0 skips the menu entirely"),
            ("nightfall", "Nightfall menu timeout", 0,
             "0 never auto-boots - it waits for a tap forever"),
        ):
            row = Adw.ActionRow(title=title, subtitle=note)
            spin = Gtk.SpinButton.new_with_range(low, 3600, 1)
            spin.set_valign(Gtk.Align.CENTER)
            btn = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
            btn.connect("clicked",
                        lambda _b, k=key, sp=spin: self._set_timeout(k, sp))
            box = Gtk.Box(spacing=6, valign=Gtk.Align.CENTER)
            box.append(spin)
            box.append(btn)
            row.add_suffix(box)
            group.add(row)
            self.timeout_rows.append((key, row, spin, note))

        # Chosen and then Set, like the timeouts, rather than applied on
        # change: every change is an authentication prompt, and refreshing
        # the rows moves these controls programmatically - applying on change
        # would turn every refresh into a write.
        self.rotate_row = Adw.ComboRow(
            title="Nightfall starting rotation",
            model=Gtk.StringList.new([f"{r}°" for r in self.ROTATIONS]))
        rot_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        rot_set.connect("clicked", lambda _b: self._run_boot_menu(
            "rotate", self.ROTATIONS[self.rotate_row.get_selected()]))
        self.rotate_row.add_suffix(rot_set)
        group.add(self.rotate_row)

        self.autorotate_row = Adw.ComboRow(
            title="Nightfall auto-rotate",
            model=Gtk.StringList.new(["On", "Off"]))
        auto_set = Gtk.Button(label="Set", valign=Gtk.Align.CENTER)
        auto_set.connect("clicked", lambda _b: self._run_boot_menu(
            "autorotate", ("on", "off")[self.autorotate_row.get_selected()]))
        self.autorotate_row.add_suffix(auto_set)
        group.add(self.autorotate_row)

        self._refresh_boot_menu()
        return group

    def _refresh_boot_menu(self):
        for key, row, spin, note in getattr(self, "timeout_rows", []):
            if key == "grub":
                value = self._grub_timeout()
                row.set_subtitle(f"{value}s — {note}" if value is not None
                                 else f"unset — {note}")
                spin.set_value(5 if value is None else value)
            else:
                value, source = self._nightfall_timeout()
                row.set_subtitle(f"{value}s{self._source_note(source)} — {note}")
                # Parks on the value in effect, never on 0 for "unset": 0 is a
                # real and, for Nightfall, dangerous setting.
                spin.set_value(value)

        if not hasattr(self, "rotate_row"):
            return
        rot, rsource = self._nightfall_rotation()
        auto, asource = self._nightfall_autorotate()
        self.rotate_row.set_selected(self.ROTATIONS.index(rot))
        self.autorotate_row.set_selected(0 if auto else 1)
        if auto:
            self.rotate_row.set_subtitle(
                f"starts at {rot}°{self._source_note(rsource)} — auto-rotate "
                f"takes over within about 750ms")
            self.autorotate_row.set_subtitle(
                f"on{self._source_note(asource)} — follows the accelerometer")
        else:
            self.rotate_row.set_subtitle(
                f"stays at {rot}°{self._source_note(rsource)} — auto-rotate "
                f"is off, so this pins it")
            self.autorotate_row.set_subtitle(
                f"off{self._source_note(asource)} — Nightfall keeps its "
                f"starting rotation")

    def _run_boot_menu(self, flag, value, extra=()):
        cli = str(REPO / "bin" / "chromebook-fixer")
        cmd = [cli, "--no-colour", "boot-menu", f"--{flag}", str(value), *extra]
        self._run_in_window(f"boot-menu {flag}", cmd,
                            stream=False, refresh_after=True)

    def _set_timeout(self, key, spin):
        value = int(spin.get_value())
        if key == "nightfall" and value == 0:
            # The CLI refuses this without -y. Ask the same question here
            # rather than passing -y silently, and say what it actually does -
            # "0" reads like "no wait", and it means the opposite.
            dialog = Adw.MessageDialog(
                transient_for=self, modal=True,
                heading="Never auto-boot?",
                body="0 does not boot immediately. It disables Nightfall's "
                     "auto-boot, so the menu waits for a tap forever. "
                     "If the touchscreen ever fails, this machine has no "
                     "keyboard to get past it.")
            dialog.add_response("cancel", "Cancel")
            dialog.add_response("go", "Set anyway")
            dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
            # Cancel on Enter and on Escape. The dangerous answer should never
            # be the one a stray keypress or a dismissed dialog produces.
            dialog.set_default_response("cancel")
            dialog.set_close_response("cancel")
            dialog.connect("response", lambda _d, r: (
                self._run_boot_menu(key, value, ("--yes",))
                if r == "go" else None))
            dialog.present()
            return
        self._run_boot_menu(key, value)

    def refresh_all(self):
        self._refresh_boot_menu()
        # Rows on any pushed page.
        for row in self.rows:
            row.refresh()

        # Category summaries. Counting here rather than on the row keeps the
        # status check in one place, and means a category cannot look calm
        # while something inside it needs attention.
        for key, (row, fixes) in self.category_rows.items():
            needed = applied = 0
            for fix in fixes:
                state, _ = fix.status()
                if state == "needed":
                    needed += 1
                elif state == "applied":
                    applied += 1
            total = len(fixes)
            if needed:
                row.set_subtitle(f"{needed} of {total} need attention")
                row.remove_css_class("dim-label")
            else:
                row.set_subtitle(f"{total} fix{'es' if total != 1 else ''}, "
                                 f"{applied} applied")
        return False

    @staticmethod
    def _row(title, subtitle):
        r = Adw.ActionRow(title=title, subtitle=subtitle)
        r.set_subtitle_lines(0)
        return r

    # -- running a fix ----------------------------------------------------

    def run_action(self, action, fix):
        """Confirm first for anything risky, then run it in a live output window."""
        if action == "apply" and (fix.risk == "high" or fix.danger):
            self._confirm(action, fix)
        else:
            self._execute(action, fix)

    def _confirm(self, action, fix):
        body = fix.danger or fix.notes or ""
        if not fix.reverts_cleanly:
            body += "\n\nThis fix cannot be cleanly reverted."
        dialog = Adw.MessageDialog(
            transient_for=self, heading=f"Apply {fix.name}?",
            body=body.strip() or "This will change system configuration.")
        dialog.add_response("cancel", "Cancel")
        dialog.add_response("go", "Apply")
        dialog.set_response_appearance("go", Adw.ResponseAppearance.DESTRUCTIVE)
        dialog.set_default_response("cancel")
        dialog.connect("response", lambda _d, r:
                       self._execute(action, fix) if r == "go" else None)
        dialog.present()

    def _execute(self, action, fix):
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"{action} {fix.id}",
                            [cli, "--no-colour", action, fix.id, "--yes"])

    def view_logs(self, fix):
        """
        Show a fix's own log.

        Read in one go rather than streamed. Streaming is right for apply,
        which is slow and where watching it matters; a log is already written,
        and Nightfall's runs past a thousand lines - pushing those through the
        main loop one idle callback at a time is visibly slow on the hardware
        this runs on.
        """
        cli = str(REPO / "bin" / "chromebook-fixer")
        self._run_in_window(f"logs {fix.id}",
                            [cli, "--no-colour", "logs", fix.id],
                            stream=False, refresh_after=False)

    def _run_in_window(self, title, cmd, stream=True, refresh_after=True):
        win = Adw.Window(transient_for=self, modal=True,
                         default_width=680, default_height=440,
                         title=title)
        tv = Adw.ToolbarView()
        tv.add_top_bar(Adw.HeaderBar())
        buf = Gtk.TextBuffer()
        view = Gtk.TextView(buffer=buf, editable=False, monospace=True,
                            wrap_mode=Pango.WrapMode.WORD_CHAR)
        tv.set_content(Gtk.ScrolledWindow(child=view, vexpand=True))
        close = Gtk.Button(label="Close", margin_top=6, margin_bottom=6,
                           margin_start=12, margin_end=12, sensitive=False)
        close.connect("clicked", lambda _b: win.close())
        tv.add_bottom_bar(close)
        win.set_content(tv)
        win.present()

        def append(text):
            buf.insert(buf.get_end_iter(), text)
            return False

        append(f"$ {' '.join(cmd)}\n\n")

        def worker():
            try:
                proc = subprocess.Popen(
                    cmd, stdout=subprocess.PIPE, stderr=subprocess.STDOUT,
                    text=True, env=askpass_env())
                if stream:
                    for line in proc.stdout:
                        GLib.idle_add(append, line)
                    proc.wait()
                else:
                    out = proc.stdout.read()
                    proc.wait()
                    GLib.idle_add(append, out)
                GLib.idle_add(append, f"\n[finished, exit {proc.returncode}]\n")
            except Exception as exc:                      # noqa: BLE001
                GLib.idle_add(append, f"\nfailed to run: {exc}\n")
            GLib.idle_add(close.set_sensitive, True)
            if refresh_after:
                GLib.idle_add(self.refresh_all)

        import threading
        threading.Thread(target=worker, daemon=True).start()


class Application(Adw.Application):
    def __init__(self):
        super().__init__(application_id="org.chromebookfixer.Gui")

    def do_activate(self):
        Window(self).present()


if __name__ == "__main__":
    sys.exit(Application().run(None))
