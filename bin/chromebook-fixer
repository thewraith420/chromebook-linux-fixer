#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""chromebook-fixer — hardware enablement fixes for Chromebooks running Linux.

    chromebook-fixer status              what this machine needs
    chromebook-fixer list                every known fix
    chromebook-fixer apply <id>|--all    install
    chromebook-fixer verify <id>         check it is still working
    chromebook-fixer revert <id>         undo

Nothing is applied without being asked for, and no fix runs unless its own
detect script says the problem is actually present on this machine.
"""

import argparse
import os
import subprocess
import sys
from pathlib import Path

sys.path.insert(0, str(Path(__file__).resolve().parent.parent / "lib"))

from registry import (CATEGORIES, Machine, load_fixes, STATE_DIR,  # noqa: E402
                      sudo_command)

DISCLAIMER = """\
chromebook-fixer makes LOW-LEVEL CHANGES to this system.

Depending on the fix, that can mean replacing system libraries, editing udev
rules, patching vendor scripts, or altering kernel behaviour. Some fixes touch
hardware that is poorly supported on Linux, and a bad interaction can HARD LOCK
the machine, requiring a forced power-off. A forced power-off can corrupt a
filesystem or lose unsaved work.

This tool is developed and tested on ONE machine (Google Nocturne). Fixes are
gated on hardware detection, but detection is imperfect and your hardware may
differ in ways the author never saw.

  * Read what a fix does before applying it: chromebook-fixer list -v
  * Every fix that can be reverted says so; some cannot be.
  * Save your work before applying anything marked HIGH RISK.
  * There is NO WARRANTY. You are responsible for your own machine.
"""


def first_run_gate(c):
    """Require an explicit acknowledgement once, before anything is applied."""
    stamp = STATE_DIR / "disclaimer-accepted"
    if stamp.exists():
        return True
    print(c("=" * 72, YELLOW))
    print(c(DISCLAIMER, YELLOW))
    print(c("=" * 72, YELLOW))
    try:
        reply = input("Type 'I understand' to continue: ").strip().lower()
    except (EOFError, KeyboardInterrupt):
        print()
        return False
    if reply != "i understand":
        print("Not acknowledged; nothing was changed.")
        return False
    STATE_DIR.mkdir(parents=True, exist_ok=True)
    stamp.write_text("acknowledged\n")
    print(c("Acknowledged. This will not be asked again.\n", DIM))
    return True

BOLD, DIM, RESET = "\033[1m", "\033[2m", "\033[0m"
RED, GREEN, YELLOW, BLUE = "\033[31m", "\033[32m", "\033[33m", "\033[34m"

STATE_STYLE = {
    "applied": (GREEN, "applied"),
    "needed": (YELLOW, "NEEDED"),
    "ok": (DIM, "not needed"),
    "unknown": (DIM, "unknown"),
}


def colour(enabled):
    return (lambda s, c: f"{c}{s}{RESET}") if enabled else (lambda s, c: s)


def by_category(fixes):
    """
    Group fixes for display, in CATEGORIES order.

    A flat list of twenty items reads as a wall of jargon, and someone opens
    this tool because one specific thing is broken. Grouping lets them skip
    straight to the part of the machine they care about.
    """
    for key, label in CATEGORIES.items():
        group = [f for f in fixes if f.category == key]
        if group:
            yield label, group


def cmd_status(args, machine, fixes, c):
    print(f"{c(machine.describe(), BOLD)}")
    print(f"  kernel {machine.kernel}")
    if not machine.is_chromebook:
        print(c("  warning: this does not look like a Chromebook "
                "(no coreboot, no GOOG* ACPI devices)", YELLOW))
    print()

    applicable = [f for f in fixes if f.matches(machine)]
    if not applicable:
        print("No fixes are known for this machine.")
        return 0

    other = len(fixes) - len(applicable)
    needed = 0
    for label, group in by_category(applicable):
        print(c(f"{label}", BOLD))
        for fix in group:
            state, detail = fix.status()
            col, lab = STATE_STYLE[state]
            if state == "needed":
                needed += 1
            state_label = f"{lab:>10}"
            print(f"  {c(state_label, col)}  {fix.id:<28} {fix.name}")
            if detail and state in ("needed", "unknown"):
                for line in detail.splitlines()[:2]:
                    print(f"              {c(line, DIM)}")
        print()

    print()
    if needed:
        print(f"{needed} fix(es) needed. Apply with: "
              f"{c('chromebook-fixer apply <id>', BOLD)}")
    else:
        print(c("Everything applicable is already in place.", GREEN))
    if other:
        print(c(f"({other} further fix(es) exist for other hardware)", DIM))
    return 0


def cmd_list(args, machine, fixes, c):
    for label, group in by_category(fixes):
        print(c(f"{label}", BOLD))
        for fix in group:
            mark = " " if fix.matches(machine) else c("·", DIM)
            risk = {"low": GREEN, "medium": YELLOW, "high": RED}.get(fix.risk, DIM)
            risk_label = f"{fix.risk:<7}"
            print(f"{mark} {fix.id:<28} {c(risk_label, risk)} {fix.name}")
            if args.verbose and fix.description:
                for line in fix.description.splitlines():
                    print(f"      {c(line, DIM)}")
        print()
    print()
    print(c("· = not applicable to this machine", DIM))
    return 0


def _run_one(fix, action, c, assume_yes=False):
    if not fix.has(action):
        print(c(f"{fix.id}: no {action} script", DIM))
        return 1

    if action == "apply":
        state, _ = fix.status()
        if state == "applied":
            print(c(f"{fix.id}: already applied", GREEN))
            return 0
        if state == "ok":
            print(c(f"{fix.id}: not needed on this machine, skipping", DIM))
            return 0
        if fix.danger or fix.risk == "high":
            print()
            print(c("  " + "!" * 68, RED))
            print(c(f"  HIGH RISK: {fix.name}", RED + BOLD)
                  if fix.risk == "high" else c(f"  WARNING: {fix.name}", YELLOW))
            for line in (fix.danger or fix.notes or "").splitlines():
                print(c(f"  {line}", RED if fix.risk == "high" else YELLOW))
            if not fix.reverts_cleanly:
                print(c("  THIS FIX CANNOT BE CLEANLY REVERTED.", RED + BOLD))
            if not fix.has("revert"):
                print(c("  No revert script exists for this fix.", RED))
            print(c("  " + "!" * 68, RED))

        if fix.risk == "high" and not assume_yes:
            # A bare y/N is too easy to hit by reflex for something that can
            # hard lock the machine; require the fix id to be typed out.
            print(f"  To proceed, type the fix id ({c(fix.id, BOLD)}), or "
                  f"anything else to skip.")
            try:
                if input("  > ").strip() != fix.id:
                    print("  skipped")
                    return 0
            except (EOFError, KeyboardInterrupt):
                print("\n  skipped")
                return 0

    if action == "apply" and fix.prefers:
        by_id = {f.id: f for f in load_fixes()}
        unmet = []
        for dep_id in fix.prefers:
            dep = by_id.get(dep_id)
            if dep and dep.status()[0] not in ("applied", "ok"):
                unmet.append(dep)
        if unmet and not assume_yes:
            print()
            print(c("  For the best result, apply these first:", YELLOW))
            for dep in unmet:
                print(c(f"    {dep.id}  —  {dep.name}", YELLOW))
            print(c("  Applying without them still works, but with reduced"
                    " capability.", YELLOW))
            print(f"  Continue with {c(fix.id, BOLD)} anyway? [y/N] ", end="")
            try:
                if input().strip().lower() not in ("y", "yes"):
                    print("  skipped — apply the prerequisite first, then retry")
                    return 0
            except (EOFError, KeyboardInterrupt):
                print("\n  skipped")
                return 0

    print(f"{c(action, BOLD)} {fix.id} … ", end="", flush=True)
    code, out = fix.run(action)
    print(c("ok", GREEN) if code == 0 else c(f"failed ({code})", RED))
    if out:
        for line in out.splitlines():
            print(f"    {line}")

    if code == 0 and action == "apply" and fix.has("verify"):
        vcode, vout = fix.run("verify")
        if vcode == 0:
            print(c("    verified", GREEN))
        else:
            print(c("    applied but verification FAILED — check manually", RED))
            if vout:
                print(f"    {vout}")
            return 1
    return code


def cmd_boot_menu(args, c):
    """
    Read or set how long each boot menu waits.

    Two menus with different mechanisms and different dangerous values, so
    they stay two flags rather than one number: GRUB's 0 boots immediately
    while Nightfall's 0 disables auto-boot and waits forever, which on a
    machine whose touchscreen may be the broken part is the unrecoverable one.
    """
    script = Path(__file__).resolve().parent.parent / "lib" / "boot-menu.sh"
    if not os.access(script, os.X_OK):
        print(c(f"missing {script}", RED))
        return 2

    env = dict(os.environ)
    cmd, askpass = sudo_command()
    env["FIXER_SUDO"] = cmd
    if askpass:
        env["SUDO_ASKPASS"] = askpass
    if args.yes:
        env["FIXER_YES"] = "1"

    worst = 0
    # (argparse dest, boot-menu.sh subcommand)
    settings = (("grub", "grub"), ("nightfall", "nightfall"), ("rotate", "rotate"),
                ("autorotate", "autorotate"), ("splash", "splash"),
                ("splash_ms", "splash-ms"))
    for dest, which in settings:
        value = getattr(args, dest)
        if value is None:
            continue
        sys.stdout.flush()
        worst = max(worst, subprocess.call([str(script), which, value], env=env))

    if all(getattr(args, d) is None for d, _ in settings):
        sys.stdout.flush()
        return subprocess.call([str(script), "show"], env=env)
    if worst == 0:
        print()
        sys.stdout.flush()
        subprocess.call([str(script), "show"], env=env)
    return worst


def cmd_logs(args, fixes, c):
    """
    Show a fix's own log, for the fixes that keep one.

    Some of what this tool installs runs where the journal does not: Nightfall
    is a whole boot environment with no syslog, no scrollback and no network,
    so it writes its account of the boot to a file and that file is the only
    record. Knowing the path was previously the entire interface.
    """
    have = [f for f in fixes if f.has("logs")]
    if not args.fix:
        if not have:
            print("No fix here keeps a log.")
            return 0
        print("Fixes that keep a log of their own:")
        for f in have:
            print(f"  {f.id:<28} {f.name}")
        print()
        print(f"Show one with: {c('chromebook-fixer logs <id>', BOLD)}")
        return 0

    match = next((f for f in fixes if f.id == args.fix), None)
    if match is None:
        print(c(f"unknown fix: {args.fix}", RED))
        return 2
    if not match.has("logs"):
        print(f"{match.id} does not keep a log of its own.")
        if have:
            print("These do: " + ", ".join(f.id for f in have))
        return 1
    # Streamed, not captured: these are long (Nightfall's runs to a thousand
    # lines of dmesg) and belong in a pager or a pipe, not in a buffer we then
    # print back.
    sys.stdout.flush()
    return match.run("logs", capture=False)[0]


def cmd_selftest(args, c):
    """
    Can these fixes still be built from nothing, today?

    Deliberately not the same question as `status`. A fix reports "applied" off
    the installed binary and the running service, which keep saying yes long
    after the source behind them stopped compiling - that is how issue #1 sat
    broken for two weeks while this machine showed green. Restoring a backup is
    a clean install, so every from-source fix has to build again exactly when
    things are already going badly, and one of them is what pkexec
    authenticates against.
    """
    script = Path(__file__).resolve().parent.parent / "lib" / "build-selftest.sh"
    if not os.access(script, os.X_OK):
        print(c(f"missing {script}", RED))
        return 2
    print(c("Building each from-source fix. Nothing is installed.", DIM))
    print()
    # Flush first: the child writes straight to the terminal while our own
    # prints sit in a buffer, so without this the header lands after the
    # results it is meant to introduce.
    sys.stdout.flush()
    return subprocess.call([str(script), *(args.fix or [])])


def installed_kernels():
    try:
        return sorted(os.listdir("/lib/modules"))
    except OSError:
        return []


def resolve_kernel(args, c):
    """Validate --kernel and export it for the fix scripts."""
    wanted = getattr(args, "kernel", None)
    if not wanted:
        return True

    available = installed_kernels()
    if wanted == "list":
        print("Installed kernels:")
        for k in available:
            marks = []
            if k == os.uname().release:
                marks.append("running")
            if Path(f"/lib/modules/{k}/build").exists():
                marks.append("buildable")
            suffix = f"  ({', '.join(marks)})" if marks else ""
            print(f"  {k}{suffix}")
        return False

    if wanted not in available:
        print(c(f"unknown kernel: {wanted}", RED))
        print("Installed kernels:")
        for k in available:
            print(f"  {k}")
        return False

    os.environ["FIXER_KERNEL"] = wanted
    if wanted != os.uname().release:
        print(c(f"Targeting {wanted}, which is not the running kernel "
                f"({os.uname().release}).", YELLOW))
        print(c("Kernel-module changes will take effect when you boot it.", YELLOW))
        print()
    return True


def cmd_action(args, machine, fixes, c):
    action = args.command
    if getattr(args, "all", False):
        targets = [f for f in fixes if f.matches(machine)]
        # Apply anything that is a prerequisite of another fix before the fix
        # that wants it, so --all does not silently produce a degraded result.
        wanted_first = {d for f in targets for d in f.prefers}
        targets.sort(key=lambda f: (f.id not in wanted_first,))
    else:
        wanted = set(args.fix or [])
        targets = [f for f in fixes if f.id in wanted]
        missing = wanted - {f.id for f in targets}
        for m in missing:
            print(c(f"unknown fix: {m}", RED))
        if missing:
            return 2
        for f in targets:
            if not f.matches(machine) and not args.force:
                print(c(f"{f.id}: not applicable to this machine "
                        f"(use --force to override)", YELLOW))
                return 2

    if not targets:
        print("Nothing to do.")
        return 0

    worst = 0
    for fix in targets:
        worst = max(worst, _run_one(fix, action, c, args.yes))
    return worst


def main():
    p = argparse.ArgumentParser(
        prog="chromebook-fixer",
        description="Hardware enablement fixes for Chromebooks running Linux.")
    p.add_argument("--no-colour", action="store_true")
    sub = p.add_subparsers(dest="command", required=True)

    sub.add_parser("status", help="what this machine needs")

    pt = sub.add_parser("boot-menu", aliases=["boot-timeout"],
                        help="what the boot menus do on their own: timeouts, "
                             "Nightfall's rotation")
    pt.add_argument("--grub", metavar="SECS",
                    help="GRUB's menu timeout (0 = no menu, -1 = wait forever)")
    pt.add_argument("--nightfall", metavar="SECS",
                    help="Nightfall's menu timeout (0 = never auto-boot)")
    pt.add_argument("--rotate", choices=["0", "90", "180", "270"],
                    help="Nightfall's STARTING rotation (with auto-rotate on, "
                         "only until the first accelerometer reading)")
    pt.add_argument("--autorotate", choices=["on", "off"],
                    help="whether Nightfall follows the accelerometer")
    pt.add_argument("--splash", choices=["on", "off"],
                    help="Nightfall's boot screens: the startup spinner and "
                         "'Booting <entry>'")
    pt.add_argument("--splash-ms", metavar="MS",
                    help="minimum time each boot screen stays up, 0-10000 "
                         "(default 1500)")
    pt.add_argument("-y", "--yes", action="store_true",
                    help="accept a timeout that can strand a keyboardless machine")

    pg = sub.add_parser("logs", help="show a fix's own diagnostic log, if it keeps one")
    pg.add_argument("fix", nargs="?", help="which fix (omit to list those that have logs)")

    ps = sub.add_parser("selftest",
                        help="do the build-from-source fixes still compile?")
    ps.add_argument("fix", nargs="*",
                    help="only these (default: every fix that builds something)")

    pl = sub.add_parser("list", help="every known fix")
    pl.add_argument("-v", "--verbose", action="store_true")

    for name, helptext in (("apply", "install a fix"),
                           ("verify", "check a fix is working"),
                           ("revert", "undo a fix")):
        sp = sub.add_parser(name, help=helptext)
        sp.add_argument("fix", nargs="*")
        sp.add_argument("--all", action="store_true",
                        help="every fix applicable to this machine")
        sp.add_argument("--force", action="store_true",
                        help="ignore hardware matching")
        sp.add_argument("-y", "--yes", action="store_true",
                        help="do not prompt for high-risk fixes")
        sp.add_argument("-k", "--kernel", metavar="VERSION",
                        help="target this kernel instead of the running one. "
                             "Only kernel-module fixes use it; everything else "
                             "ignores it. Use --kernel list to see the options.")

    args = p.parse_args()
    c = colour(sys.stdout.isatty() and not args.no_colour)
    machine = Machine.detect()
    fixes = load_fixes()

    if args.command == "status":
        return cmd_status(args, machine, fixes, c)
    # argparse records whichever name was typed, so the alias arrives as itself.
    if args.command in ("boot-menu", "boot-timeout"):
        return cmd_boot_menu(args, c)
    if args.command == "logs":
        return cmd_logs(args, fixes, c)
    if args.command == "selftest":
        return cmd_selftest(args, c)
    if args.command == "list":
        return cmd_list(args, machine, fixes, c)
    # --kernel list is a query, so answer it before demanding a fix id.
    if not resolve_kernel(args, c):
        return 0 if getattr(args, "kernel", None) == "list" else 2
    if not args.fix and not args.all:
        print("specify a fix id, or --all")
        return 2
    if args.command in ("apply", "revert") and not first_run_gate(c):
        return 1
    return cmd_action(args, machine, fixes, c)


if __name__ == "__main__":
    sys.exit(main())
