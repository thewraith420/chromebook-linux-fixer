[Unit]
Description=Chromebook EC volume-button recovery (polls the EC event FIFO)
Documentation=https://github.com/thewraith420/chromebook-linux-fixer
# Only meaningful once the EC chardev exists.
ConditionPathExists=/dev/cros_ec

[Service]
Type=simple
# apply.sh installs the daemon here (the unit sets ProtectHome=true, so it
# cannot be run out of the repo under /home).
ExecStart=/usr/local/bin/chromebook-ec-buttons
Restart=on-failure
RestartSec=2
# It needs /dev/cros_ec and /dev/uinput; keep everything else locked down.
DevicePolicy=closed
DeviceAllow=/dev/cros_ec rw
DeviceAllow=/dev/uinput rw
ProtectSystem=strict
ProtectHome=true
PrivateTmp=true
PrivateNetwork=true
NoNewPrivileges=true

[Install]
WantedBy=multi-user.target
