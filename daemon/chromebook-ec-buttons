#!/usr/bin/env python3
# SPDX-License-Identifier: GPL-3.0-or-later
"""chromebook-ec-buttons — recover the volume buttons when the EC never fires.

On some Chrome EC convertibles (confirmed: Google Nocturne / Pixel Slate) the
EC never delivers MKBP events to the AP after boot: the interrupt fires once at
startup and never again, and the ACPI notify path is dead too. The volume
buttons, the sensor FIFO and the lid angle all go silent even though the EC's
own console proves the events are happening.

The *synchronous* command path is unaffected — EC_CMD_GET_NEXT_EVENT drains the
FIFO fine on demand. This daemon does exactly that from userspace: it polls the
EC event FIFO through /dev/cros_ec and re-injects the volume keys through a
uinput device, so applications and the desktop see ordinary KEY_VOLUMEUP /
KEY_VOLUMEDOWN presses.

This is the userspace equivalent of the in-kernel poll fix (kernel patch 9201).
Use one or the other, never both — if the kernel is already draining the FIFO,
this daemon would race it for events. The fixer's detect step checks for that.

Deliberately handles volume only. The power button is intentionally left alone.
"""

import ctypes
import fcntl
import os
import struct
import sys
import time

# --- /dev/cros_ec command interface (include/linux/platform_data/cros_ec_chardev.h) ---
CROS_EC_DEV = "/dev/cros_ec"
# _IOWR(0xEC, 0, struct cros_ec_command); struct cros_ec_command is 5 * u32 = 20 bytes
CROS_EC_DEV_IOCXCMD = (3 << 30) | (20 << 16) | (0xEC << 8) | 0  # 0xC014EC00

EC_CMD_GET_NEXT_EVENT = 0x0067
EC_RES_SUCCESS = 0

# MKBP event types (cros_ec_commands.h). Bit 7 of event_type = "more events".
EC_MKBP_EVENT_BUTTON = 3
EC_MKBP_HAS_MORE_EVENTS = 0x80

# Button bitmap bits within an EC_MKBP_EVENT_BUTTON payload.
EC_MKBP_VOL_UP = 1
EC_MKBP_VOL_DOWN = 2

# struct cros_ec_command = { u32 version, command, outsize, insize, result; u8 data[]; }
_HDR = struct.Struct("=IIIII")
_EVENT_INSIZE = 16  # room for the largest event payload we care about

POLL_INTERVAL = 0.03  # 30 ms, matching the kernel fallback's cadence

# --- uinput (linux/uinput.h) ---
UINPUT_DEV = "/dev/uinput"
UI_SET_EVBIT = (1 << 30) | (4 << 16) | (ord("U") << 8) | 100   # _IOW('U',100,int)
UI_SET_KEYBIT = (1 << 30) | (4 << 16) | (ord("U") << 8) | 101  # _IOW('U',101,int)
UI_DEV_SETUP = (1 << 30) | (92 << 16) | (ord("U") << 8) | 3    # _IOW('U',3,struct uinput_setup=92)
UI_DEV_CREATE = (ord("U") << 8) | 1                            # _IO('U',1)
UI_DEV_DESTROY = (ord("U") << 8) | 2                           # _IO('U',2)

EV_SYN, EV_KEY = 0x00, 0x01
SYN_REPORT = 0
KEY_VOLUMEDOWN, KEY_VOLUMEUP = 114, 115

BUTTON_KEYS = {EC_MKBP_VOL_UP: KEY_VOLUMEUP, EC_MKBP_VOL_DOWN: KEY_VOLUMEDOWN}

# struct input_event on 64-bit: struct timeval (2*long) + u16 type + u16 code + s32 value
_INPUT_EVENT = struct.Struct("=qqHHi")


def log(msg):
    print(f"chromebook-ec-buttons: {msg}", file=sys.stderr, flush=True)


class Uinput:
    """A minimal uinput virtual keyboard exposing the volume keys."""

    def __init__(self):
        self.fd = os.open(UINPUT_DEV, os.O_WRONLY | os.O_NONBLOCK)
        fcntl.ioctl(self.fd, UI_SET_EVBIT, EV_KEY)
        for key in (KEY_VOLUMEUP, KEY_VOLUMEDOWN):
            fcntl.ioctl(self.fd, UI_SET_KEYBIT, key)
        # struct uinput_setup { struct input_id{u16 bustype,vendor,product,version}; char name[80]; u32 ff_effects_max; }
        setup = struct.pack("=HHHH80sI", 0x03, 0x18d1, 0x5001, 1,
                            b"Chromebook EC volume keys", 0)
        setup = setup.ljust(92, b"\x00")
        fcntl.ioctl(self.fd, UI_DEV_SETUP, setup)
        fcntl.ioctl(self.fd, UI_DEV_CREATE)

    def emit(self, code, value):
        os.write(self.fd, _INPUT_EVENT.pack(0, 0, EV_KEY, code, value))
        os.write(self.fd, _INPUT_EVENT.pack(0, 0, EV_SYN, SYN_REPORT, 0))

    def close(self):
        try:
            fcntl.ioctl(self.fd, UI_DEV_DESTROY)
        except OSError:
            pass
        os.close(self.fd)


def next_event(ec_fd):
    """Issue EC_CMD_GET_NEXT_EVENT once. Returns (event_type, buttons_bitmap)
    or None when the FIFO is empty / on a transient error."""
    buf = bytearray(_HDR.size + _EVENT_INSIZE)
    _HDR.pack_into(buf, 0, 0, EC_CMD_GET_NEXT_EVENT, 0, _EVENT_INSIZE, 0)
    try:
        fcntl.ioctl(ec_fd, CROS_EC_DEV_IOCXCMD, buf, True)
    except OSError:
        return None
    result = _HDR.unpack_from(buf, 0)[4]
    if result != EC_RES_SUCCESS:
        return None  # EC_RES_UNAVAILABLE etc. — no event waiting
    data = buf[_HDR.size:]
    event_type = data[0] & ~EC_MKBP_HAS_MORE_EVENTS
    buttons = struct.unpack_from("=I", data, 1)[0]
    return event_type, buttons


def run():
    ui = Uinput()
    pressed = 0  # last-seen button bitmap, for edge detection
    log("started; polling /dev/cros_ec for volume-button events")
    ec_fd = None
    try:
        while True:
            if ec_fd is None:
                try:
                    ec_fd = os.open(CROS_EC_DEV, os.O_RDWR)
                except OSError as e:
                    log(f"cannot open {CROS_EC_DEV} ({e}); retrying")
                    time.sleep(1.0)
                    continue
            # Drain everything currently in the FIFO this tick.
            for _ in range(64):
                ev = next_event(ec_fd)
                if ev is None:
                    break
                event_type, buttons = ev
                if event_type != EC_MKBP_EVENT_BUTTON:
                    continue
                changed = buttons ^ pressed
                for bit, key in BUTTON_KEYS.items():
                    if changed & (1 << bit):
                        ui.emit(key, 1 if buttons & (1 << bit) else 0)
                pressed = buttons
            time.sleep(POLL_INTERVAL)
    finally:
        if ec_fd is not None:
            os.close(ec_fd)
        ui.close()


if __name__ == "__main__":
    try:
        run()
    except KeyboardInterrupt:
        pass
